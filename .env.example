# Copy this file to .env and fill in the values. Add the same names in Vercel > Settings > Environment Variables.

# Google Sheet used as the database. Share the sheet with GOOGLE_CLIENT_EMAIL as Editor.
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
# The service account's private key, in quotes, on one line with \n between lines
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# PIN for the Admin panel, and PIN the teacher types on the phone in Class Battle
ADMIN_PIN=1010
TEACHER_PIN=1010
